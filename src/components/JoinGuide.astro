---
import { getJoinPaths } from "../lib/content";

const joinPaths = await getJoinPaths();
---

<div class="join-guide">
  <div class="guide-title"><span aria-hidden="true" class="guide-cursor">▸</span><div><p>NEW PLAYER GUIDE</p><h2>Select your path</h2></div></div>
  <div role="tablist" aria-label="Student programs" class="guide-tabs" aria-orientation="horizontal">
    {joinPaths.map((path, index) => (
      <button role="tab" id={`tab-${path.id}`} type="button" aria-controls={`panel-${path.id}`} aria-selected={index === 0 ? "true" : "false"} tabindex={index === 0 ? 0 : -1}>{path.label}</button>
    ))}
  </div>
  {joinPaths.map((path, index) => (
    <section role="tabpanel" id={`panel-${path.id}`} aria-labelledby={`tab-${path.id}`} class="guide-panel" tabindex="0">
      <h3>{path.heading}</h3><p>{path.intro}</p><ol>{path.steps.map((step) => <li>{step}</li>)}</ol>
      {path.note && <p class="guide-note">{path.note}</p>}
    </section>
  ))}
</div>

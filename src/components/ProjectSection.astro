---
import { getProjects } from "../lib/content";

interface Props {
  showMoreLink?: boolean;
}
const { showMoreLink = true } = Astro.props;
const projects = (await getProjects()).filter((project) => project.featured);
---

<section aria-labelledby="work-title" class="section work-section" id="projects">
  <div class="container">
    <div class="section-header">
      <div><h2 id="work-title">Current projects and studies</h2></div>
      {showMoreLink && <a class="more" href="/research/">All research</a>}
    </div>
    <div class="work-grid">
      {projects.map((project, index) => (
        <a class:list={["work", { feature: index === 0 }]} href={`/research/${project.id}/`}>
          <div class="work-label"><span>{project.label}</span><span class="work-no">{project.displayNumber}</span></div>
          <div class="work-content"><h3>{project.title}</h3><p>{project.description}</p><span class="work-more">Project details</span></div>
        </a>
      ))}
    </div>
  </div>
</section>

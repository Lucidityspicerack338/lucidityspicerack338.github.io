---
import PubList from "./PubList.astro";
import { getPublications, recentPapers } from "../lib/content";

const homepagePublications = recentPapers(await getPublications(), 6);
---

<section aria-labelledby="publications-title" class="section publications" id="publications">
  <div class="container">
    <div class="section-header">
      <div><h2 id="publications-title">Recent publications</h2></div>
      <a class="more" href="/publications/">All publications</a>
    </div>
    <PubList publications={homepagePublications} />
  </div>
</section>

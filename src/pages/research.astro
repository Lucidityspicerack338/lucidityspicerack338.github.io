---
import BaseLayout from "../layouts/BaseLayout.astro";
import SimpleHeader from "../components/SimpleHeader.astro";
import SimpleFooter from "../components/SimpleFooter.astro";
import InteriorHero from "../components/InteriorHero.astro";
import ResearchSection from "../components/ResearchSection.astro";
import ProjectSection from "../components/ProjectSection.astro";
import { getSiteSettings } from "../lib/content";

const siteSettings = await getSiteSettings();
---

<BaseLayout title={`Research and Projects — ${siteSettings.labName}`} bodyClass="v8-page interior-page">
  <SimpleHeader current="research" />
  <main id="main">
    <InteriorHero
      eyebrow="RESEARCH"
      title="Research and projects"
      intro="Our research brings together work on health technologies, digital play, and the experiences of people who use them."
    />
    <ResearchSection />
    <ProjectSection />
  </main>
  <SimpleFooter backLink />
</BaseLayout>

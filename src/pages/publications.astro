---
import BaseLayout from "../layouts/BaseLayout.astro";
import SimpleHeader from "../components/SimpleHeader.astro";
import SimpleFooter from "../components/SimpleFooter.astro";
import InteriorHero from "../components/InteriorHero.astro";
import PubList from "../components/PubList.astro";
import { awardedPublications, formatAuthors, getPublicationUrl, getPublications, getSiteSettings } from "../lib/content";

const publications = await getPublications();
const siteSettings = await getSiteSettings();
const years = [...new Set(publications.map((publication) => publication.year))].sort((a, b) => b - a);
const venues = [...new Set(publications.map((publication) => publication.venue))].sort();
const awards = awardedPublications(publications);
---

<BaseLayout title={`Publications — ${siteSettings.labName}`} bodyClass="v8-page interior-page publications-page">
  <SimpleHeader current="publications" />
  <main id="main">
    <InteriorHero
      title="Publications"
    />
    {awards.length > 0 && (
      <section class="awards-section" aria-labelledby="awards-title">
        <div class="page-shell">
          <h2 id="awards-title">Paper awards</h2>
          <PubList publications={awards} />
        </div>
      </section>
    )}
    <section class="archive-section" aria-labelledby="publication-list-title">
      <div class="page-shell">
        <form class="publication-filters" id="publication-filters" role="search">
          <div class="filter-field filter-search">
            <label for="publication-search">Search publications</label>
            <input id="publication-search" type="search" name="query" placeholder="Title, author, venue, or year" autocomplete="off" />
          </div>
          <div class="filter-field">
            <label for="publication-year">Year</label>
            <select id="publication-year" name="year"><option value="">All years</option>{years.map((year) => <option value={year}>{year}</option>)}</select>
          </div>
          <div class="filter-field">
            <label for="publication-venue">Venue</label>
            <select id="publication-venue" name="venue"><option value="">All venues</option>{venues.map((venue) => <option value={venue}>{venue}</option>)}</select>
          </div>
          <button class="filter-reset" type="reset">Reset</button>
        </form>
        <div class="archive-heading">
          <h2 id="publication-list-title" class="visually-hidden">All publications</h2>
          <p id="publication-count" role="status" aria-live="polite">{publications.length} publications</p>
        </div>
        <ol class="publication-index" id="publication-index">
          {publications.map((publication) => {
            const publicationUrl = getPublicationUrl(publication);
            const authors = formatAuthors(publication.authors);

            return (
            <li
              class="publication-record"
              data-year={publication.year}
              data-venue={publication.venue.toLowerCase()}
              data-search={`${publication.title} ${authors} ${publication.venue} ${publication.year} ${publication.award ?? ""}`.toLowerCase()}
            >
              <div class="publication-date"><strong>{publication.venue}</strong><span>{publication.month} {publication.year}</span></div>
              <div class="publication-copy">
                <h3>
                  {publicationUrl ? (
                    <a href={publicationUrl} rel="noopener noreferrer" target="_blank">{publication.title}</a>
                  ) : publication.title}
                </h3>
                <p>{authors}{publication.award ? ` · ${publication.award}` : ""}</p>
              </div>
            </li>
            );
          })}
        </ol>
        <p class="filter-empty" id="publication-empty" hidden>No publications match those filters. <button class="filter-clear" type="reset" form="publication-filters">Clear all filters</button></p>
      </div>
    </section>
  </main>
  <SimpleFooter backLink />
  <script is:inline src="/scripts/publications.js"></script>
</BaseLayout>

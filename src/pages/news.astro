---
import BaseLayout from "../layouts/BaseLayout.astro";
import SimpleHeader from "../components/SimpleHeader.astro";
import SimpleFooter from "../components/SimpleFooter.astro";
import InteriorHero from "../components/InteriorHero.astro";
import { getNewsItems, getNewsSourceLinks, getSiteSettings } from "../lib/content";

const newsItems = await getNewsItems();
const siteSettings = await getSiteSettings();
---

<BaseLayout title={`News — ${siteSettings.labName}`} bodyClass="v8-page interior-page news-page">
  <SimpleHeader current="news" />
  <main id="main">
    <InteriorHero
      title="News"
    />
    <section class="archive-section" aria-label="All news items">
      <div class="page-shell">
        <div class="news-archive">
          {newsItems.map((item) => {
            const sourceLinks = getNewsSourceLinks(item);

            return (
            <article class="news-archive-item">
              <div class="news-archive-meta"><time datetime={item.date}>{item.displayDate}</time></div>
              <div class="news-archive-copy">
                <h2>{item.title}</h2><p>{item.summary}</p>
                {item.details.length > 0 && (
                  <ul class="news-details" aria-label="Announcement details">
                    {item.details.map((detail) => <li>{detail}</li>)}
                  </ul>
                )}
                {sourceLinks.length > 0 && (
                  <ul class="source-links" aria-label="Sources and publication links">
                    {sourceLinks.map((link) => <li><a href={link.url} rel="noopener noreferrer" target="_blank">{link.label}</a></li>)}
                  </ul>
                )}
              </div>
            </article>
            );
          })}
        </div>
      </div>
    </section>
  </main>
  <SimpleFooter backLink />
</BaseLayout>

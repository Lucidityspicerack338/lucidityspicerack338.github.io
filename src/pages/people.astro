---
import BaseLayout from "../layouts/BaseLayout.astro";
import SimpleHeader from "../components/SimpleHeader.astro";
import SimpleFooter from "../components/SimpleFooter.astro";
import InteriorHero from "../components/InteriorHero.astro";
import PeopleDirectory from "../components/PeopleDirectory.astro";
import { getSiteSettings } from "../lib/content";

const siteSettings = await getSiteSettings();
---

<BaseLayout title={`People — ${siteSettings.labName}`} bodyClass="v8-page interior-page people-page">
  <SimpleHeader current="people" />
  <main id="main">
    <InteriorHero
      eyebrow="PEOPLE"
      title="People"
      intro="The Health and Play Lab is jointly directed by Xinning Gui and Yubo Kou. Our members work across health technologies, digital play, privacy, safety, and online communities."
    />
    <PeopleDirectory />
  </main>
  <SimpleFooter backLink />
</BaseLayout>
